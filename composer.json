{
    "name": "weldist/spatie-medialibrary-uuid-path-generator",
    "description": "A UUID-based path generator for spatie/laravel-medialibrary.",
    "keywords": ["laravel", "spatie", "medialibrary", "uuid", "path-generator"],
    "license": "MIT",
    "authors": [
        {
            "name": "X-Adam",
            "email": "www@mehmetogmen.com.tr",
            "homepage": "https://mehmetogmen.com.tr"
        }
    ],
    "require": {
        "php": "^8.3",
        "spatie/laravel-medialibrary": "^11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Weldist\\Spatie\\MediaLibrary\\UuidPathGenerator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Weldist\\Spatie\\MediaLibrary\\UuidPathGenerator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Weldist\\Spatie\\MediaLibrary\\UuidPathGenerator\\UuidPathGeneratorServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
